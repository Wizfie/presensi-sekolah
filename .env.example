# ==============================================================================
# KONFIGURASI ENVIRONMENT (LOCAL & CLOUDFLARE PAGES PRODUCTION)
# ==============================================================================
# Cara mengambil dari Supabase Dashboard:
# 1) Cara cepat: tombol "Connect" di bar atas -> App Frameworks -> Vue
# 2) Via menu  : Project Settings (ikon gerigi kiri bawah) ->
#    - Data API : salin "Project URL" -> VITE_SUPABASE_URL
#    - API Keys : salin "Publishable key" (sb_publishable_...) atau tab Legacy
#                 "anon public" (eyJhbGci...) -> VITE_SUPABASE_ANON_KEY
# PENTING: JANGAN PERNAH memakai Secret key (sb_secret_...) / service_role key!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_or_anon_jwt

# Kontrol tampilan tombol "Akses Demo Cepat" di halaman Login:
# - Set 'true' saat sesi presentasi / demo awal
# - Set 'false' (atau kosongkan) saat sudah live production untuk sekolah
VITE_ENABLE_DEMO_LOGIN=false
